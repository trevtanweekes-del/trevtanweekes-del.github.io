:root {
  --background: #ffffff;
  --surface: #f3f6f9;
  --text: #17212b;
  --muted: #425466;
  --primary: #0b3d66;
  --link: #005ea8;
  --focus: #ffbf47;
  --border: #c7d0d9;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 1.05rem;
  line-height: 1.65;
}

.container {
  width: min(92%, 70rem);
  margin-inline: auto;
}

.skip-link {
  position: absolute;
  left: 0.5rem;
  top: -4rem;
  background: #ffffff;
  color: #000000;
  padding: 0.75rem 1rem;
  z-index: 1000;
}

.skip-link:focus {
  top: 0.5rem;
  outline: 0.2rem solid var(--focus);
}

.site-header {
  background: var(--primary);
  color: #ffffff;
  padding: 3.5rem 0 2rem;
}

.eyebrow {
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

h1 {
  font-size: clamp(2.4rem, 7vw, 4.5rem);
  line-height: 1.05;
  margin: 0.25rem 0;
}

.tagline {
  max-width: 48rem;
  font-size: 1.25rem;
}

nav ul, .tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.25rem;
  padding: 0;
  list-style: none;
}

nav a {
  color: #ffffff;
  font-weight: 700;
}

a {
  color: var(--link);
  text-decoration-thickness: 0.12em;
  text-underline-offset: 0.16em;
}

a:hover {
  text-decoration-thickness: 0.2em;
}

a:focus-visible {
  outline: 0.2rem solid var(--focus);
  outline-offset: 0.2rem;
}

main {
  padding-block: 2rem 4rem;
}

section {
  padding-block: 1.5rem;
}

h2 {
  color: var(--primary);
  font-size: 1.8rem;
}

h3 {
  font-size: 1.25rem;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 0.5rem;
  padding: 1.25rem;
}

.tag-list li {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 0.35rem 0.75rem;
}

footer {
  background: var(--surface);
  border-top: 1px solid var(--border);
  padding: 1.25rem 0;
}

@media (max-width: 38rem) {
  body {
    font-size: 1rem;
  }
  .site-header {
    padding-top: 2.5rem;
  }
  nav ul {
    display: block;
  }
  nav li {
    margin-block: 0.65rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
}
